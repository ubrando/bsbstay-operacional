# Copie para .env e preencha com os valores do SEU projeto Supabase de
# DESENVOLVIMENTO (não o do cliente!). Crie um projeto separado, gratuito,
# só para testar localmente — nunca aponte isso para o Supabase de produção
# do cliente. Ver README.md, seção "Ambientes".
# Valores em: Supabase > Project Settings > API. Nunca commitar o .env real.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Usados no lado servidor (SSR / Cloudflare Worker)
SUPABASE_URL=
